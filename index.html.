<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Sky Battle V11 - Part 3</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  user-select:none;
  touch-action:none;
}

body{
  overflow:hidden;
  background:#020617;
  font-family:Arial,sans-serif;
}

canvas{
  display:block;
  width:100vw;
  height:100vh;
}

.screen{
  position:fixed;
  inset:0;
  z-index:100;
  overflow:auto;
  padding:20px;
  color:white;
  text-align:center;
  background:linear-gradient(#061936,#020617);
}

.hidden{
  display:none!important;
}

h1{
  margin:15px 0 20px;
  font-size:32px;
}

button{
  padding:12px 18px;
  margin:6px;
  border:0;
  border-radius:12px;
  background:#168cff;
  color:white;
  font-weight:bold;
}

button:active{
  transform:scale(.95);
}

.menuBtn{
  display:block;
  width:280px;
  max-width:90%;
  margin:12px auto;
}

.card{
  width:340px;
  max-width:95%;
  margin:12px auto;
  padding:15px;
  border-radius:15px;
  background:rgba(255,255,255,.1);
}

#hud{
  position:fixed;
  top:7px;
  left:8px;
  z-index:20;
  color:white;
  font-size:12px;
  line-height:19px;
  text-shadow:2px 2px 4px #000;
}

.bar{
  width:145px;
  height:8px;
  background:#222;
  border:1px solid white;
  border-radius:5px;
  overflow:hidden;
}

#hp{
  width:100%;
  height:100%;
  background:#20dd66;
}

#shield{
  width:100%;
  height:100%;
  background:#20aaff;
}

#ult{
  width:0%;
  height:100%;
  background:#ffe000;
}

#missionText{
  position:fixed;
  top:7px;
  left:50%;
  transform:translateX(-50%);
  z-index:20;
  color:white;
  font-weight:bold;
  text-shadow:2px 2px 4px #000;
}

#combo{
  position:fixed;
  top:32px;
  left:50%;
  transform:translateX(-50%);
  z-index:20;
  color:#ffe000;
  font-weight:bold;
}

#bossBar{
  display:none;
  position:fixed;
  top:60px;
  left:50%;
  transform:translateX(-50%);
  width:270px;
  height:12px;
  z-index:20;
  background:#222;
  border:1px solid white;
}

#bossHP{
  width:100%;
  height:100%;
  background:#e91e63;
}

#pause{
  position:fixed;
  top:7px;
  right:7px;
  z-index:30;
}

#fire{
  position:fixed;
  right:18px;
  bottom:18px;
  width:85px;
  height:85px;
  border-radius:50%;
  z-index:30;
  background:#e53935;
  border:3px solid white;
}

#weapon{
  position:fixed;
  right:20px;
  bottom:112px;
  z-index:30;
  font-size:11px;
}

#ultimateBtn{
  position:fixed;
  right:118px;
  bottom:22px;
  z-index:30;
  background:#c49b00;
}

#joystick{
  position:fixed;
  left:18px;
  bottom:18px;
  width:125px;
  height:125px;
  border-radius:50%;
  border:2px solid rgba(255,255,255,.45);
  background:rgba(255,255,255,.1);
  z-index:30;
}

#stick{
  position:absolute;
  left:35px;
  top:35px;
  width:55px;
  height:55px;
  border-radius:50%;
  background:rgba(255,255,255,.8);
}

#result{
  display:none;
  position:fixed;
  z-index:200;
  width:320px;
  max-width:90%;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  padding:25px;
  color:white;
  text-align:center;
  border-radius:18px;
  background:rgba(0,5,20,.97);
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<!-- MENU -->
<div id="menu" class="screen">

<h1>🚀 SKY BATTLE V11</h1>

<p>PART 3 — FULL COMBINED EDITION</p>

<br>

<p>🪙 Coins:
<span id="menuCoins">0</span>
</p>

<p>🏆 Best Score:
<span id="bestScore">0</span>
</p>

<button class="menuBtn" onclick="openMissions()">
🗺️ MISSIONS
</button>

<button class="menuBtn" onclick="openHangar()">
✈️ HANGAR
</button>

<button class="menuBtn" onclick="openShop()">
🛠️ UPGRADES
</button>

<button class="menuBtn" onclick="openAchievements()">
🏆 ACHIEVEMENTS
</button>

</div>


<!-- MISSIONS -->
<div id="missions" class="screen hidden">

<h1>🗺️ MISSIONS</h1>

<div id="missionList"></div>

<button class="menuBtn" onclick="backMenu()">
⬅️ BACK
</button>

</div>


<!-- HANGAR -->
<div id="hangar" class="screen hidden">

<h1>✈️ HANGAR</h1>

<div id="planeList"></div>

<button class="menuBtn" onclick="backMenu()">
⬅️ BACK
</button>

</div>


<!-- SHOP -->
<div id="shop" class="screen hidden">

<h1>🛠️ UPGRADES</h1>

<p>🪙 Coins:
<span id="shopCoins">0</span>
</p>

<button onclick="upgrade('power')">
⚡ POWER +1 — 20 Coins
</button>

<button onclick="upgrade('health')">
❤️ HP +25 — 25 Coins
</button>

<button onclick="upgrade('speed')">
💨 SPEED +1 — 30 Coins
</button>

<button onclick="upgrade('shield')">
🛡️ SHIELD +20 — 35 Coins
</button>

<button class="menuBtn" onclick="backMenu()">
⬅️ BACK
</button>

</div>


<!-- ACHIEVEMENTS -->
<div id="achievements" class="screen hidden">

<h1>🏆 ACHIEVEMENTS</h1>

<div id="achievementList"></div>

<button class="menuBtn" onclick="backMenu()">
⬅️ BACK
</button>

</div>


<!-- HUD -->
<div id="hud">

⭐ Score:
<span id="score">0</span>

<br>

🪙 Coins:
<span id="coins">0</span>

<br>

🎯 Mission:
<span id="mission">1</span>

<br>

❤️ HP

<div class="bar">
<div id="hp"></div>
</div>

🛡️ Shield

<div class="bar">
<div id="shield"></div>
</div>

⚡ Ultimate

<div class="bar">
<div id="ult"></div>
</div>

</div>

<div id="missionText">
READY
</div>

<div id="combo">
🔥 Combo: 0
</div>

<div id="bossBar">
<div id="bossHP"></div>
</div>

<button id="pause">
⏸️
</button>

<button id="fire">
FIRE
</button>

<button id="weapon" onclick="changeWeapon()">
🔫 SINGLE
</button>

<button id="ultimateBtn" onclick="ultimateAttack()">
⚡ ULTIMATE
</button>

<div id="joystick">
<div id="stick"></div>
</div>


<!-- RESULT -->
<div id="result">

<h2 id="resultTitle">
MISSION COMPLETE
</h2>

<p id="resultText"></p>

<button onclick="nextMission()">
NEXT
</button>

<button onclick="backMenu()">
MENU
</button>

</div>


<script>

/* ==================================
CANVAS
================================== */

const canvas =
document.getElementById("game");

const ctx =
canvas.getContext("2d");

function resize(){

canvas.width =
innerWidth;

canvas.height =
innerHeight;

}

resize();

addEventListener(
"resize",
resize
);


/* ==================================
SAVE
================================== */

let coins =
Number(localStorage.getItem("sbCoins"))||0;

let unlocked =
Number(localStorage.getItem("sbUnlocked"))||1;

let totalKills =
Number(localStorage.getItem("sbKills"))||0;

let bestScore =
Number(localStorage.getItem("sbBest"))||0;

let selectedPlane =
localStorage.getItem("sbPlane")||
"fighter";

let upgrades =
JSON.parse(
localStorage.getItem("sbUpgrades")||
'{"power":0,"health":0,"speed":0,"shield":0}'
);


/* ==================================
PLANES
================================== */

const planes={

scout:{
icon:"🟢",
name:"SCOUT",
speed:9,
power:3,
health:90,
shield:40
},

fighter:{
icon:"🔵",
name:"FIGHTER",
speed:6,
power:6,
health:130,
shield:70
},

heavy:{
icon:"🟠",
name:"HEAVY",
speed:3,
power:10,
health:220,
shield:130
},

viper:{
icon:"🟣",
name:"VIPER",
speed:10,
power:7,
health:100,
shield:60
},

titan:{
icon:"⚪",
name:"TITAN",
speed:4,
power:12,
health:300,
shield:190
},

falcon:{
icon:"🦅",
name:"FALCON",
speed:7,
power:9,
health:170,
shield:110
},

phantom:{
icon:"👻",
name:"PHANTOM",
speed:11,
power:7,
health:100,
shield:55
},

thunder:{
icon:"⚡",
name:"THUNDER",
speed:6,
power:15,
health:240,
shield:160
},

dragon:{
icon:"🐉",
name:"DRAGON",
speed:4,
power:18,
health:350,
shield:240
},

legend:{
icon:"👑",
name:"LEGEND",
speed:8,
power:22,
health:450,
shield:330
}

};

let plane =
planes[selectedPlane];


/* ==================================
MAPS
================================== */

const maps=[

{
name:"🌊 OCEAN",
top:"#075985",
bottom:"#020617"
},

{
name:"🌲 FOREST",
top:"#14532d",
bottom:"#020617"
},

{
name:"🏜️ DESERT",
top:"#b45309",
bottom:"#451a03"
},

{
name:"🏙️ CITY",
top:"#334155",
bottom:"#020617"
},

{
name:"❄️ SNOW",
top:"#bae6fd",
bottom:"#0f172a"
}

];


/* ==================================
MISSIONS
================================== */

let missions=[];

for(
let i=0;
i<20;
i++
){

missions.push({

id:i+1,

target:
10+i*5,

map:
i%5,

boss:
(i+1)%5===0

});

}


/* ==================================
PLAYER
================================== */

const player={

x:canvas.width/2,

y:canvas.height-100,

speed:
plane.speed+
upgrades.speed,

power:
plane.power+
upgrades.power,

maxHP:
plane.health+
upgrades.health*25,

hp:
plane.health+
upgrades.health*25,

maxShield:
plane.shield+
upgrades.shield*20,

shield:
plane.shield+
upgrades.shield*20

};


/* ==================================
GAME VARIABLES
================================== */

let playing=false;

let paused=false;

let gameOver=false;

let currentMission=0;

let score=0;

let kills=0;

let spawnTimer=0;

let formationTimer=0;

let bullets=[];

let enemies=[];

let enemyBullets=[];

let particles=[];

let powerups=[];

let missiles=[];

let boss=null;

let ultimate=0;

let combo=0;

let comboTimer=0;

let maxCombo=0;

let invincible=0;

let screenShake=0;

let weaponIndex=0;

let weaponNames=[

"SINGLE",

"TRIPLE",

"SPREAD",

"LASER",

"MISSILE",

"NOVA"

];


/* ==================================
STARS
================================== */

let stars=[];

for(
let i=0;
i<180;
i++
){

stars.push({

x:
Math.random()*canvas.width,

y:
Math.random()*canvas.height,

speed:
1+Math.random()*4

});

}


/* ==================================
SOUND
================================== */

let audioCtx=null;

function sound(
frequency,
duration=.07
){

try{

if(!audioCtx){

audioCtx=
new(
window.AudioContext||
window.webkitAudioContext
)();

}

if(
audioCtx.state==="suspended"
){

audioCtx.resume();

}

let osc=
audioCtx.createOscillator();

let gain=
audioCtx.createGain();

osc.frequency.value=
frequency;

gain.gain.setValueAtTime(
.04,
audioCtx.currentTime
);

gain.gain.exponentialRampToValueAtTime(
.001,
audioCtx.currentTime+
duration
);

osc.connect(gain);

gain.connect(
audioCtx.destination
);

osc.start();

osc.stop(
audioCtx.currentTime+
duration
);

}catch(e){}

}


/* ==================================
MENU
================================== */

function hideScreens(){

document
.querySelectorAll(".screen")
.forEach(
x=>
x.classList.add("hidden")
);

}

function backMenu(){

playing=false;

hideScreens();

document
.getElementById("menu")
.classList.remove("hidden");

updateUI();

}

function openMissions(){

hideScreens();

document
.getElementById("missions")
.classList.remove("hidden");

renderMissions();

}

function openHangar(){

hideScreens();

document
.getElementById("hangar")
.classList.remove("hidden");

renderPlanes();

}

function openShop(){

hideScreens();

document
.getElementById("shop")
.classList.remove("hidden");

updateUI();

}

function openAchievements(){

hideScreens();

document
.getElementById("achievements")
.classList.remove("hidden");

renderAchievements();

}


/* ==================================
MISSION LIST
================================== */

function renderMissions(){

let html="";

missions.forEach(
m=>{

let locked=
m.id>unlocked;

html+=`

<div class="card">

<h2>
Mission ${m.id}
</h2>

<p>
${maps[m.map].name}
</p>

<p>
Enemy Target:
${m.target}
</p>

<p>
${
m.boss
?
"👑 BOSS MISSION"
:
"⚔️ COMBAT MISSION"
}
</p>

<button
${locked?"disabled":""}
onclick="startMission(${m.id-1})">

${
locked
?
"🔒 LOCKED"
:
"▶ START"
}

</button>

</div>

`;

});

document
.getElementById(
"missionList"
)
.innerHTML=html;

}


/* ==================================
HANGAR
================================== */

function renderPlanes(){

let html="";

Object.keys(planes)
.forEach(
key=>{

let p=
planes[key];

html+=`

<div class="card">

<h2>
${p.icon}
${p.name}
</h2>

<p>
💨 Speed: ${p.speed}
</p>

<p>
⚡ Power: ${p.power}
</p>

<p>
❤️ HP: ${p.health}
</p>

<p>
🛡️ Shield: ${p.shield}
</p>

<button
onclick="selectPlane('${key}')">

SELECT

</button>

</div>

`;

});

document
.getElementById(
"planeList"
)
.innerHTML=html;

}


/* ==================================
SELECT PLANE
================================== */

function selectPlane(key){

selectedPlane=key;

plane=
planes[key];

player.speed=
plane.speed+
upgrades.speed;

player.power=
plane.power+
upgrades.power;

player.maxHP=
plane.health+
upgrades.health*25;

player.maxShield=
plane.shield+
upgrades.shield*20;

player.hp=
player.maxHP;

player.shield=
player.maxShield;

save();

}


/* ==================================
UPGRADES
================================== */

function upgrade(type){

let costs={

power:20,

health:25,

speed:30,

shield:35

};

if(
coins<
costs[type]
)
return;

coins-=
costs[type];

upgrades[type]++;

if(
type==="power"
)
player.power++;

if(
type==="speed"
)
player.speed++;

if(
type==="health"
){

player.maxHP+=25;

player.hp=
player.maxHP;

}

if(
type==="shield"
){

player.maxShield+=20;

player.shield=
player.maxShield;

}

save();

updateUI();

}


/* ==================================
ACHIEVEMENTS
================================== */

function renderAchievements(){

let list=[

[
"First Flight",
totalKills>=1
],

[
"Destroyer",
totalKills>=50
],

[
"Air Ace",
totalKills>=100
],

[
"Boss Hunter",
unlocked>=6
],

[
"Mission Master",
unlocked>=20
],

[
"Combo King",
maxCombo>=25
]

];

let html="";

list.forEach(
a=>{

html+=`

<div class="card">

<h2>
${a[1]?"✅":"🔒"}
${a[0]}
</h2>

</div>

`;

});

document
.getElementById(
"achievementList"
)
.innerHTML=html;

}


/* ==================================
SAVE
================================== */

function save(){

localStorage.setItem(
"sbCoins",
coins
);

localStorage.setItem(
"sbUnlocked",
unlocked
);

localStorage.setItem(
"sbKills",
totalKills
);

localStorage.setItem(
"sbBest",
bestScore
);

localStorage.setItem(
"sbPlane",
selectedPlane
);

localStorage.setItem(
"sbUpgrades",
JSON.stringify(
upgrades
)
);

}


/* ==================================
START MISSION
================================== */

function startMission(index){

if(
index+1>
unlocked
)
return;

currentMission=index;

score=0;

kills=0;

combo=0;

maxCombo=0;

comboTimer=0;

ultimate=0;

invincible=0;

bullets=[];

enemies=[];

enemyBullets=[];

particles=[];

powerups=[];

missiles=[];

boss=null;

spawnTimer=20;

formationTimer=300;

gameOver=false;

playing=true;

paused=false;

player.x=
canvas.width/2;

player.y=
canvas.height-100;

player.hp=
player.maxHP;

player.shield=
player.maxShield;

document
.getElementById("result")
.style.display="none";

document
.getElementById("bossBar")
.style.display="none";

hideScreens();

sound(500,.15);

}


/* ==================================
SHOOT
================================== */

function shoot(){

if(
!playing||
paused||
gameOver
)
return;

let x=
player.x;

let y=
player.y-40;


/* SINGLE */

if(
weaponIndex===0
){

bullets.push({

x:x,

y:y,

dx:0,

dy:-14,

damage:
45+
player.power*8

});

}


/* TRIPLE */

if(
weaponIndex===1
){

for(
let i=-1;
i<=1;
i++
){

bullets.push({

x:x,

y:y,

dx:i*2,

dy:-13,

damage:
35+
player.power*6

});

}

}


/* SPREAD */

if(
weaponIndex===2
){

for(
let i=-4;
i<=4;
i++
){

bullets.push({

x:x,

y:y,

dx:i*1.4,

dy:-11,

damage:
28+
player.power*5

});

}

}


/* LASER */

if(
weaponIndex===3
){

bullets.push({

x:x,

y:y,

dx:0,

dy:-20,

damage:
130+
player.power*15,

laser:true

});

}


/* MISSILE */

if(
weaponIndex===4
){

missiles.push({

x:x,

y:y,

target:null,

speed:7,

damage:
170+
player.power*10

});

}


/* NOVA */

if(
weaponIndex===5
){

for(
let i=0;
i<24;
i++
){

let a=
Math.PI*2*i/24;

bullets.push({

x:x,

y:y,

dx:
Math.cos(a)*7,

dy:
Math.sin(a)*7,

damage:
120+
player.power*10

});

}

}

sound(
400+
weaponIndex*80,
.04
);

}


/* ==================================
WEAPON
================================== */

function changeWeapon(){

weaponIndex++;

if(
weaponIndex>=
weaponNames.length
){

weaponIndex=0;

}

document
.getElementById(
"weapon"
)
.innerText=
"🔫 "+
weaponNames[
weaponIndex
];

}


/* ==================================
ULTIMATE
================================== */

function ultimateAttack(){

if(
ultimate<100||
!playing
)
return;

ultimate=0;

enemies.forEach(
e=>
e.health-=1500
);

if(boss)
boss.hp-=2500;

for(
let i=0;
i<45;
i++
){

let a=
Math.PI*2*i/45;

bullets.push({

x:player.x,

y:player.y,

dx:
Math.cos(a)*9,

dy:
Math.sin(a)*9,

damage:1200

});

}

screenShake=25;

sound(
70,
.5
);

}


/* ==================================
ENEMY TYPES
================================== */

const enemyTypes=[

"normal",

"fast",

"tank",

"zigzag",

"shooter",

"splitter",

"charger",

"elite",

"sniper",

"miniBoss"

];


/* ==================================
SPAWN ENEMY
================================== */

function spawnEnemy(){

let type=
enemyTypes[
Math.floor(
Math.random()*
enemyTypes.length
)
];

let level=
currentMission+1;

let e={

x:
30+
Math.random()*
(canvas.width-60),

y:-60,

type:type,

health:
100+
level*30,

speed:
2+
level*.08,

time:0,

shootTimer:
70+
Math.random()*80

};

if(
type==="fast"
){

e.speed=5;

e.health=70;

}

if(
type==="tank"
){

e.speed=1;

e.health=600;

}

if(
type==="zigzag"
){

e.speed=2.5;

}

if(
type==="shooter"
){

e.speed=1.5;

}

if(
type==="splitter"
){

e.health=250;

e.speed=2;

}

if(
type==="charger"
){

e.health=180;

e.speed=6;

}

if(
type==="elite"
){

e.health=700;

e.speed=2.5;

}

if(
type==="sniper"
){

e.health=220;

e.speed=1;

}

if(
type==="miniBoss"
){

e.health=1200;

e.speed=1;

}

enemies.push(e);

}


/* ==================================
FORMATION
================================== */

function spawnFormation(){

let count=
5+
Math.floor(
currentMission/3
);

for(
let i=0;
i<count;
i++
){

enemies.push({

x:
80+
i*
(
(canvas.width-160)/
Math.max(
1,
count-1
)
),

y:-50-i*45,

type:"formation",

health:
120+
currentMission*25,

speed:2.2,

time:i

});

}

}


/* ==================================
ENEMY SHOOT
================================== */

function enemyShoot(e){

enemyBullets.push({

x:e.x,

y:e.y,

dx:
(player.x-e.x)/100,

dy:4,

damage:
12+
currentMission

});

}


/* ==================================
BOSS
================================== */

function createBoss(){

let hp=
3500+
currentMission*800;

boss={

x:
canvas.width/2,

y:-130,

maxHP:hp,

hp:hp,

phase:1,

timer:60,

direction:1

};

document
.getElementById(
"bossBar"
)
.style.display=
"block";

}


/* ==================================
BOSS ATTACK
================================== */

function bossAttack(){

if(!boss)
return;

let attack=
Math.floor(
Math.random()*4
);

if(
attack===0
){

for(
let i=0;
i<20;
i++
){

let a=
Math.PI*2*i/20;

enemyBullets.push({

x:boss.x,

y:boss.y,

dx:
Math.cos(a)*5,

dy:
Math.sin(a)*5,

damage:22

});

}

}

else if(
attack===1
){

for(
let i=-5;
i<=5;
i++
){

enemyBullets.push({

x:boss.x,

y:boss.y,

dx:i*1.2,

dy:6,

damage:30

});

}

}

else if(
attack===2
){

enemyBullets.push({

x:boss.x,

y:boss.y,

dx:
(player.x-boss.x)/35,

dy:
(player.y-boss.y)/35,

damage:50

});

}

else{

for(
let i=0;
i<3;
i++
){

missiles.push({

x:boss.x,

y:boss.y,

target:player,

speed:4,

damage:35,

enemy:true

});

}

}

sound(
90,
.3
);

}


/* ==================================
UPDATE BOSS
================================== */

function updateBoss(){

if(!boss)
return;

if(
boss.y<120
){

boss.y+=2;

return;

}

boss.timer--;

boss.x+=
boss.direction*
(
boss.phase+1
);

if(
boss.x>
canvas.width-80||
boss.x<80
){

boss.direction*=-1;

}

if(
boss.hp<
boss.maxHP*.66
&&
boss.phase===1
){

boss.phase=2;

screenShake=15;

}

if(
boss.hp<
boss.maxHP*.33
&&
boss.phase===2
){

boss.phase=3;

screenShake=20;

}

if(
boss.timer<=0
){

bossAttack();

boss.timer=
boss.phase===1
?
80
:
boss.phase===2
?
55
:
30;

}

if(
boss.hp<=0
){

explode(
boss.x,
boss.y
);

coins+=200;

score+=5000;

boss=null;

document
.getElementById(
"bossBar"
)
.style.display=
"none";

completeMission();

}

}


/* ==================================
DESTROY ENEMY
================================== */

function destroyEnemy(e){

let index=
enemies.indexOf(e);

if(
index===-1
)
return;

explode(
e.x,
e.y
);

if(
e.type==="splitter"
){

for(
let i=0;
i<3;
i++
){

enemies.push({

x:e.x+
(i-1)*25,

y:e.y,

type:"fast",

health:50,

speed:4,

time:0,

shootTimer:100

});

}

}

if(
Math.random()<.22
){

spawnPowerup(
e.x,
e.y
);

}

enemies.splice(
index,
1
);

kills++;

totalKills++;

combo++;

comboTimer=120;

maxCombo=
Math.max(
maxCombo,
combo
);

score+=
10+
combo*3;

coins+=2;

ultimate=
Math.min(
100,
ultimate+2
);

sound(
300+
combo*10,
.05
);

save();

}


/* ==================================
POWERUPS
================================== */

function spawnPowerup(x,y){

let types=[

"health",

"shield",

"power",

"ultimate",

"invincible",

"missile",

"bomb"

];

powerups.push({

x:x,

y:y,

type:
types[
Math.floor(
Math.random()*
types.length
)
],

speed:2

});

}

function collectPowerup(p){

if(
p.type==="health"
){

player.hp=
Math.min(
player.maxHP,
player.hp+70
);

}

if(
p.type==="shield"
){

player.shield=
Math.min(
player.maxShield,
player.shield+80
);

}

if(
p.type==="power"
){

player.power+=3;

}

if(
p.type==="ultimate"
){

ultimate=
Math.min(
100,
ultimate+40
);

}

if(
p.type==="invincible"
){

invincible=600;

}

if(
p.type==="missile"
){

for(
let i=0;
i<3;
i++
){

missiles.push({

x:player.x,

y:player.y,

target:null,

speed:7,

damage:200

});

}

}

if(
p.type==="bomb"
){

enemies.forEach(
e=>
e.health-=700
);

}

sound(
700,
.1
);

}


/* ==================================
MISSILE UPDATE
================================== */

function updateMissiles(){

for(
let i=
missiles.length-1;
i>=0;
i--
){

let m=
missiles[i];

if(
m.enemy
){

let dx=
player.x-m.x;

let dy=
player.y-m.y;

let d=
Math.hypot(dx,dy)||1;

m.x+=
dx/d*m.speed;

m.y+=
dy/d*m.speed;

if(
Math.hypot(
m.x-player.x,
m.y-player.y
)<30
){

if(
invincible<=0
){

player.hp-=
m.damage;

}

missiles.splice(
i,
1
);

}

continue;

}

if(
!m.target||
!enemies.includes(
m.target
)
){

let closest=null;

let distance=Infinity;

enemies.forEach(
e=>{

let d=
Math.hypot(
e.x-m.x,
e.y-m.y
);

if(
d<distance
){

distance=d;

closest=e;

}

});

m.target=closest;

}

if(
m.target
){

let dx=
m.target.x-m.x;

let dy=
m.target.y-m.y;

let d=
Math.hypot(dx,dy)||1;

m.x+=
dx/d*m.speed;

m.y+=
dy/d*m.speed;

}

if(
m.target&&
Math.hypot(
m.x-m.target.x,
m.y-m.target.y
)<30
){

let target=
m.target;

target.health-=
m.damage;

explode(
target.x,
target.y
);

missiles.splice(
i,
1
);

if(
target.health<=0
){

destroyEnemy(
target
);

}

}

}

}


/* ==================================
EXPLOSION
================================== */

function explode(x,y){

for(
let i=0;
i<25;
i++
){

particles.push({

x:x,

y:y,

dx:
(Math.random()-.5)*8,

dy:
(Math.random()-.5)*8,

life:
20+
Math.random()*35

});

}

screenShake=8;

}


/* ==================================
UPDATE
================================== */

function update(){

if(
!playing||
paused||
gameOver
)
return;


/* STARS */

stars.forEach(
s=>{

s.y+=s.speed;

if(
s.y>
canvas.height
){

s.y=-5;

s.x=
Math.random()*
canvas.width;

}

});


/* PLAYER */

player.x+=
joy.dx*
player.speed;

player.y+=
joy.dy*
player.speed;

player.x=
Math.max(
25,
Math.min(
canvas.width-25,
player.x
)
);

player.y=
Math.max(
50,
Math.min(
canvas.height-50,
player.y
)
);


/* COMBO */

if(
combo>0
){

comboTimer--;

if(
comboTimer<=0
){

combo=0;

}

}


/* INVINCIBLE */

if(
invincible>0
)
invincible--;


/* SPAWN */

spawnTimer--;

if(
spawnTimer<=0&&
kills<
missions[
currentMission
].target&&
!boss
){

spawnEnemy();

spawnTimer=
Math.max(
12,
42-
currentMission*1.5
);

}


/* FORMATION */

formationTimer--;

if(
formationTimer<=0&&
kills<
missions[
currentMission
].target&&
!boss
){

spawnFormation();

formationTimer=450;

}


/* BULLETS */

for(
let i=
bullets.length-1;
i>=0;
i--
){

let b=
bullets[i];

b.x+=
b.dx||0;

b.y+=
b.dy||0;

if(
b.x<0||
b.x>canvas.width||
b.y<0||
b.y>canvas.height
){

bullets.splice(
i,
1
);

continue;

}


/* BOSS HIT */

if(
boss&&
Math.hypot(
b.x-boss.x,
b.y-boss.y
)<70
){

boss.hp-=
b.damage;

bullets.splice(
i,
1
);

continue;

}


/* ENEMY HIT */

for(
let j=
enemies.length-1;
j>=0;
j--
){

let e=
enemies[j];

if(
Math.hypot(
b.x-e.x,
b.y-e.y
)<35
){

e.health-=
b.damage;

bullets.splice(
i,
1
);

if(
e.health<=0
){

destroyEnemy(e);

}

break;

}

}

}


/* ENEMIES */

for(
let i=
enemies.length-1;
i>=0;
i--
){

let e=
enemies[i];

e.y+=
e.speed;

if(
e.type==="zigzag"
){

e.time+=.1;

e.x+=
Math.sin(
e.time
)*3;

}

if(
e.type==="charger"&&
e.y>canvas.height/2
){

e.x+=
(player.x-e.x)*.02;

}

e.shootTimer--;

if(
(
e.type==="shooter"||
e.type==="sniper"||
e.type==="miniBoss"
)&&
e.shootTimer<=0
){

enemyShoot(e);

e.shootTimer=
e.type==="sniper"
?
140
:
90;

}

if(
Math.hypot(
e.x-player.x,
e.y-player.y
)<42
){

if(
invincible<=0
){

player.hp-=35;

}

explode(
e.x,
e.y
);

enemies.splice(
i,
1
);

}

if(
e.y>
canvas.height+70
){

enemies.splice(
i,
1
);

}

}


/* ENEMY BULLETS */

for(
let i=
enemyBullets.length-1;
i>=0;
i--
){

let b=
enemyBullets[i];

b.x+=
b.dx||0;

b.y+=
b.dy||0;

if(
Math.hypot(
b.x-player.x,
b.y-player.y
)<30
){

if(
invincible<=0
){

if(
player.shield>0
){

player.shield-=
b.damage;

if(
player.shield<0
){

player.hp+=
player.shield;

player.shield=0;

}

}else{

player.hp-=
b.damage;

}

}

enemyBullets.splice(
i,
1
);

}

}


/* POWERUPS */

for(
let i=
powerups.length-1;
i>=0;
i--
){

let p=
powerups[i];

p.y+=
p.speed;

if(
Math.hypot(
p.x-player.x,
p.y-player.y
)<40
){

collectPowerup(p);

powerups.splice(
i,
1
);

}

}


/* MISSILES */

updateMissiles();


/* BOSS START */

if(
kills>=
missions[
currentMission
].target&&
missions[
currentMission
].boss&&
!boss
){

createBoss();

}


/* NORMAL COMPLETE */

if(
kills>=
missions[
currentMission
].target&&
!missions[
currentMission
].boss&&
!boss
){

completeMission();

}


/* BOSS */

updateBoss();


/* PARTICLES */

particles.forEach(
p=>{

p.x+=p.dx;

p.y+=p.dy;

p.life--;

});

particles=
particles.filter(
p=>
p.life>0
);


/* SHIELD REGEN */

if(
player.shield<
player.maxShield
){

player.shield+=.03;

}


/* SHAKE */

if(
screenShake>0
)
screenShake--;


/* GAME OVER */

if(
player.hp<=0
){

loseGame();

}

updateUI();

}


/* ==================================
RESULT
================================== */

function completeMission(){

if(gameOver)
return;

gameOver=true;

playing=false;

coins+=30;

if(
currentMission+2>
unlocked&&
currentMission<19
){

unlocked=
currentMission+2;

}

if(
score>bestScore
){

bestScore=score;

}

save();

document
.getElementById(
"resultTitle"
)
.innerText=
"🏆 MISSION COMPLETE";

document
.getElementById(
"resultText"
)
.innerText=
"Score: "+
score+
" | Kills: "+
kills+
" | Reward: +30 Coins";

document
.getElementById(
"result"
)
.style.display=
"block";

}


function loseGame(){

gameOver=true;

playing=false;

document
.getElementById(
"resultTitle"
)
.innerText=
"💥 GAME OVER";

document
.getElementById(
"resultText"
)
.innerText=
"Your plane was destroyed.";

document
.getElementById(
"result"
)
.style.display=
"block";

}


function nextMission(){

document
.getElementById(
"result"
)
.style.display=
"none";

if(
currentMission<19
){

startMission(
currentMission+1
);

}else{

backMenu();

}

}


/* ==================================
PAUSE
================================== */

document
.getElementById("pause")
.onclick=
()=>{

paused=!paused;

document
.getElementById("pause")
.innerText=
paused
?
"▶️"
:
"⏸️";

};


/* ==================================
AUTO FIRE
================================== */

document
.getElementById("fire")
.addEventListener(
"touchstart",
e=>{

e.preventDefault();

shoot();

}
);

document
.getElementById("fire")
.addEventListener(
"mousedown",
shoot
);

setInterval(
()=>{

if(
playing&&
!paused
){

shoot();

}

},
350
);


/* ==================================
JOYSTICK
================================== */

let joy={

dx:0,

dy:0

};

const joystick=
document.getElementById(
"joystick"
);

const stick=
document.getElementById(
"stick"
);

function moveStick(x,y){

let r=
joystick.getBoundingClientRect();

let cx=
r.left+
r.width/2;

let cy=
r.top+
r.height/2;

let dx=
x-cx;

let dy=
y-cy;

let d=
Math.hypot(dx,dy);

let max=42;

if(
d>max
){

dx=
dx/d*max;

dy=
dy/d*max;

}

joy.dx=
dx/max;

joy.dy=
dy/max;

stick.style.left=
35+dx+"px";

stick.style.top=
35+dy+"px";

}

joystick.addEventListener(
"touchmove",
e=>{

e.preventDefault();

moveStick(
e.touches[0].clientX,
e.touches[0].clientY
);

}
);

joystick.addEventListener(
"touchend",
()=>{

joy.dx=0;

joy.dy=0;

stick.style.left=
"35px";

stick.style.top=
"35px";

}
);


/* ==================================
DRAW
================================== */

function draw(){

ctx.save();

if(
screenShake>0
){

ctx.translate(

(Math.random()-.5)*
screenShake,

(Math.random()-.5)*
screenShake

);

}


/* BACKGROUND */

let map=
maps[
currentMission
%5
];

let gradient=
ctx.createLinearGradient(
0,
0,
0,
canvas.height
);

gradient.addColorStop(
0,
map.top
);

gradient.addColorStop(
1,
map.bottom
);

ctx.fillStyle=
gradient;

ctx.fillRect(
0,
0,
canvas.width,
canvas.height
);


/* STARS */

ctx.fillStyle=
"white";

stars.forEach(
s=>{

ctx.fillRect(
s.x,
s.y,
2,
2
);

});


/* PLAYER */

if(
playing
){

ctx.save();

ctx.translate(
player.x,
player.y
);

if(
invincible>0
){

ctx.strokeStyle=
"#ffe000";

ctx.lineWidth=4;

ctx.beginPath();

ctx.arc(
0,
0,
50,
0,
Math.PI*2
);

ctx.stroke();

}

ctx.fillStyle=
"#22a7ff";

ctx.beginPath();

ctx.moveTo(
0,-45
);

ctx.lineTo(
25,30
);

ctx.lineTo(
0,43
);

ctx.lineTo(
-25,30
);

ctx.closePath();

ctx.fill();

ctx.fillStyle=
"#e0f7ff";

ctx.beginPath();

ctx.ellipse(
0,
-15,
7,
13,
0,
0,
Math.PI*2
);

ctx.fill();

ctx.restore();

}


/* ENEMIES */

enemies.forEach(
e=>{

ctx.save();

ctx.translate(
e.x,
e.y
);

let color=
"#e53935";

if(
e.type==="fast"
)
color="#ff9800";

if(
e.type==="tank"
)
color="#9c27b0";

if(
e.type==="zigzag"
)
color="#00e5ff";

if(
e.type==="shooter"
)
color="#ffeb3b";

if(
e.type==="elite"
)
color="#ff1493";

if(
e.type==="sniper"
)
color="#00ff88";

if(
e.type==="miniBoss"
)
color="#ff0000";

if(
e.type==="formation"
)
color="#f97316";

ctx.fillStyle=
color;

ctx.beginPath();

ctx.moveTo(
0,35
);

ctx.lineTo(
25,-25
);

ctx.lineTo(
0,-35
);

ctx.lineTo(
-25,-25
);

ctx.closePath();

ctx.fill();

ctx.restore();

});


/* BOSS */

if(boss){

ctx.save();

ctx.translate(
boss.x,
boss.y
);

ctx.fillStyle=

boss.phase===1
?
"#e91e63"
:
boss.phase===2
?
"#ff5722"
:
"#ff0000";

ctx.beginPath();

ctx.moveTo(
0,-65
);

ctx.lineTo(
75,45
);

ctx.lineTo(
0,25
);

ctx.lineTo(
-75,45
);

ctx.closePath();

ctx.fill();

ctx.restore();

}


/* BULLETS */

bullets.forEach(
b=>{

ctx.fillStyle=
"#fff000";

ctx.fillRect(
b.x-3,
b.y-10,
6,
20
);

});


/* ENEMY BULLETS */

enemyBullets.forEach(
b=>{

ctx.fillStyle=
"#ff4444";

ctx.beginPath();

ctx.arc(
b.x,
b.y,
5,
0,
Math.PI*2
);

ctx.fill();

});


/* MISSILES */

missiles.forEach(
m=>{

ctx.fillStyle=
m.enemy
?
"#ff3333"
:
"#ff9800";

ctx.beginPath();

ctx.arc(
m.x,
m.y,
6,
0,
Math.PI*2
);

ctx.fill();

});


/* POWERUPS */

powerups.forEach(
p=>{

let icon=

p.type==="health"
?
"❤️"
:
p.type==="shield"
?
"🛡️"
:
p.type==="power"
?
"⚡"
:
p.type==="ultimate"
?
"⭐"
:
p.type==="invincible"
?
"🔰"
:
p.type==="missile"
?
"🚀"
:
"💣";

ctx.font=
"25px Arial";

ctx.textAlign=
"center";

ctx.fillText(
icon,
p.x,
p.y
);

});


/* PARTICLES */

particles.forEach(
p=>{

ctx.fillStyle=
"orange";

ctx.beginPath();

ctx.arc(
p.x,
p.y,
5,
0,
Math.PI*2
);

ctx.fill();

});


ctx.restore();

}


/* ==================================
UI
================================== */

function updateUI(){

document
.getElementById("coins")
.innerText=
coins;

document
.getElementById("menuCoins")
.innerText=
coins;

document
.getElementById("shopCoins")
.innerText=
coins;

document
.getElementById("bestScore")
.innerText=
bestScore;

document
.getElementById("score")
.innerText=
score;

document
.getElementById("mission")
.innerText=
currentMission+1;

document
.getElementById("missionText")
.innerText=

maps[
currentMission%5
].name+
" | "+
kills+
"/"+
missions[
currentMission
].target;

document
.getElementById("combo")
.innerText=

"🔥 Combo: "+
combo+
" | Max: "+
maxCombo;

document
.getElementById("hp")
.style.width=

Math.max(
0,
player.hp/
player.maxHP*100
)+"%";

document
.getElementById("shield")
.style.width=

Math.max(
0,
player.shield/
player.maxShield*100
)+"%";

document
.getElementById("ult")
.style.width=
ultimate+
"%";

if(boss){

document
.getElementById("bossHP")
.style.width=

Math.max(
0,
boss.hp/
boss.maxHP*100
)+"%";

}

}


/* ==================================
GAME LOOP
================================== */

function loop(){

update();

draw();

requestAnimationFrame(
loop
);

}


/* ==================================
INIT
================================== */

renderMissions();

renderPlanes();

renderAchievements();

updateUI();

loop();

</script>

</body>
</html>
